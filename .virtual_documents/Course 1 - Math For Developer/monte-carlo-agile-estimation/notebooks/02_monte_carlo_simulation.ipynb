def compare_experiments(*results: SimulationResult) -> None:

    n = len(results)
    colors = ['steelblue', 'darkorange', 'darkgreen', 'darkred']
    percentile_colors = {50: 'green', 75: 'orange', 85: 'red', 95: 'purple'}

    # Charr 1: Side by side histograms
    fig, axes = plt.subplots(1, n, figsize=(7 * n, 5), sharey=False)
    fig.suptitle('Experiment Comparison: Distribution of Simulated Durations',
                 fontsize=12, y=1.01)

    if n == 1:
        axes = [axes]

    for i, result in enumerate(results):
        ax = axes[i]
        color = colors[i % len(colors)]
        naive_mean = float(np.mean(result.cleaned_data))

        ax.hist(
            result.all_durations,
            bins=40,
            color=color,
            edgecolor='white',
            linewidth=0.4,
            density=False,
            alpha=0.85,
        )
        for p, days in result.percentile_forecasts.items():
            ax.axvline(days,
                       color=percentile_colors.get(p, 'gray'),
                       linewidth=1.5, linestyle='--',
                       label=f'P{p}: {days:.0f}d')
        ax.axvline(naive_mean, color='black', linewidth=2,
                   linestyle=':', label=f'Mean: {naive_mean:.0f}d')

        ax.set_xlabel('Duration (days)')
        ax.set_ylabel('Count per bin')
        ax.set_title(result.experiment_label, fontsize=10)
        ax.legend(fontsize=8)
        ax.xaxis.set_major_locator(mticker.MultipleLocator(10))
        ax.tick_params(axis='x', rotation=45)

    plt.tight_layout()
    plt.show()

    # Chart 2: Overlaid CDFs
    fig, ax = plt.subplots(figsize=(12, 6))
    fig.suptitle('Experiment Comparison: Overlaid CDFs',
                 fontsize=12, y=1.01)
    short_labels = ['Experiment 1', 'Experiment 2', 'Experiment 3']
    
    for i, result in enumerate(results):
        color = colors[i % len(colors)]
        sorted_d = np.sort(result.all_durations)
        cdf = np.arange(1, len(sorted_d) + 1) / len(sorted_d) * 100
        short = short_labels[i] if i < len(short_labels) else f'Exp {i+1}'
        ax.plot(sorted_d, cdf, color = color, linewidth = 2.0, label = result.experiment_label)

        # Mark P75 on each curve only — keeps chart readable
        if 75 in result.percentile_forecasts:
            p75 = result.percentile_forecasts[75]
            ax.plot(p75, 75, 'o', color = color, markersize = 7, zorder = 5, label=f'{short} P75: {p75:.0f}d')

    ax.set_xlabel('Integration duration (days)')
    ax.set_ylabel('Probability (%)')
    ax.set_title('Cumulative probability by experiment')
    ax.set_ylim(0, 105)
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'{x:.0f}%'))
    ax.xaxis.set_major_locator(mticker.MultipleLocator(20))
    ax.tick_params(axis='x', rotation=45)
    ax.grid(axis='y', alpha=0.3)
    ax.legend(fontsize=9)
    
    plt.tight_layout()
    plt.show()


compare_experiments(result_1, result_3)





def calibration_check(
    historical_data: list,
    min_days: int = 4,
    max_days: int = 90,
    n_simulations: int = 10_000,
    percentiles: list = [50, 75, 85, 95],
    random_seed: int = 42,
) -> None:
    cleaned = clean_data(historical_data, min_days, max_days)
    n = len(cleaned)
    rng = np.random.default_rng(random_seed)

    #Track how often each held-out value falls below the Pk forecast
    coverage_counts = {p: 0 for p in percentiles}

    for i in range(n):
        held_out = cleaned[i]
        training = cleaned[:i] + cleaned[i+1:]  # leave one out

        # Simulate on the training set
        draws = rng.choice(training, size=n_simulations, replace=True)
        forecasts = compute_percentiles(draws, percentiles)

        for p in percentiles:
            if held_out <= forecasts[p]:
                coverage_counts[p] += 1

    print('CALIBRATION CHECK (leave-one-out, n =', n, 'observations)')
    print(f'  {"Percentile":<12} {"Target":<10} {"Observed":<12} {"Std Error":<12} {"Bias"}')
    print('  ' + '-' * 55)
    for p in percentiles:
        target   = p / 100
        observed = coverage_counts[p] / n
        std_err  = np.sqrt(target * (1 - target) / n)
        bias     = observed - target
        direction = 'overconfident' if bias < 0 else 'underconfident' if bias > 0 else 'perfect'
        print(f'  P{p:<11} {target:<10.0%} {observed:<12.1%} {std_err:<12.1%} {bias:+.1%} ({direction})')
    
calibration_check(raw_jira_data)









