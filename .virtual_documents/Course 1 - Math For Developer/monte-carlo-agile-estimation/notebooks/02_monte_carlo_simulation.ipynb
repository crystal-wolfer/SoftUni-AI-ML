    # Complexity: what kind of integration is it?
    complexity_distribution={'simple': 0.4, 'medium': 0.4, 'complex': 0.2},
    complexity_multipliers=_complexity_multipliers,

    # Capacity: how stretched is the team or how much urgent extra work is expected? (the impact is usually noticeable but it isnt that big)
    capacity_distribution={'full': 0.6, 'reduced': 0.35, 'minimal': 0.05},
    capacity_multipliers={'full': 1.0, 'reduced': 1.2, 'minimal': 1.4},

    # Experience: who from the team is doing the work? (the levels are distinguishable in the team but the difference is not that big)
    experience_distribution={'junior': 0.3, 'mid': 0.5, 'senior': 0.2},
    experience_multipliers={'junior': 1.2, 'mid': 1.0, 'senior': 0.7},

    # Provider responsiveness: how fast does the other side respond? (blocking providers can indeed stall an integration completion for a month or even more)
    provider_distribution={'very_responsive': 0.6, 'responsive': 0.3, 'slow': 0.05, 'blocking': 0.05},
    provider_delay_days={'very_responsive': 2, 'responsive': 7, 'slow': 14, 'blocking': 21},

    n_simulations=10_000,
    percentiles=[50, 75, 85, 95],
    random_seed=42,
)

