    min_days=4,
    max_days=90,
    n_simulations=10_000,
    percentiles=[50, 75, 85, 95],
    random_seed=42,
)

review_experiment(result_1)





def simulate_parallel_integrations(
    historical_data: list,
    integration_complexities: list,
    complexity_multipliers: dict,
    min_days: int = 4,
    max_days: int = 90,
    n_simulations: int = 10_000,
    percentiles: list = [50, 75, 85, 95],
    random_seed: int = 42,
) -> SimulationResult:
   #Validate inputs - complexities and complexity multipliers are mandatory inputs
    if len(integration_complexities) == 0:
        raise ValueError("integration_complexities must contain at least one entry.")

    for i, label in enumerate(integration_complexities):
        if label not in complexity_multipliers:
            raise ValueError(
                f"integration_complexities[{i}] = '{label}' is not defined in complexity_multipliers."
                f"Please pick one of the vailable labels: {list(complexity_multipliers.keys())}"
            )

    rng = np.random.default_rng(random_seed)
    n_integrations = len(integration_complexities)

    #Clean the data
    cleaned = clean_data(historical_data, min_days, max_days)
    removed = sorted([x for x in historical_data if x <= min_days or x > max_days])

    print(f"Raw observations: {len(historical_data)}")
    print(f"After cleaning: {len(cleaned)}")
    print(f"Removed: {len(removed)} values")
    print(f"Removed values: {removed}")
    print(f"\nIntegrations in parallel: {n_integrations}")

    #Run simulation build a [n_simulations, n_integrations] array.
    #Each column is one integration, each row is one simulation run.
    all_individual = np.zeros((n_simulations, n_integrations))

    for i, label in enumerate(integration_complexities):
        multiplier = complexity_multipliers[label]

        #Draw base cycle times from the empirical distribution
        base_draws = rng.choice(cleaned, size=n_simulations, replace=True)

        #Apply fixed complexity multiplier
        scaled = base_draws * multiplier
        all_individual[:, i] = scaled

    #Combined completion time = max across all integrations per run
    all_durations = np.max(all_individual, axis=1)

    #Compute results
    percentile_forecasts = compute_percentiles(all_durations, percentiles)

    result = SimulationResult(
        experiment_label=(
            f'Experiment 2: {n_integrations} Parallel Integrations '
            f'({", ".join(integration_complexities)})'
        ),
        cleaned_data=cleaned,
        all_durations=all_durations,
        percentile_forecasts=percentile_forecasts,
        mean=float(np.mean(all_durations)),
        median=float(np.median(all_durations)),
        std=float(np.std(all_durations)),
        parameters_used={
            'n_integrations': n_integrations,
            'integration_complexities': integration_complexities,
            'complexity_multipliers': complexity_multipliers,
            'min_days': min_days,
            'max_days': max_days,
            'n_simulations': n_simulations,
            'percentiles': percentiles,
            'random_seed': random_seed,
        }
    )

    #Store results in dataclass
    result._individual_durations = all_individual
    return result





#Compute data-driven multipliers
_cleaned = clean_data(raw_jira_data, min_days=4, max_days=90)
_median = np.median(_cleaned)

complexity_multipliers = {
    'simple': round(np.percentile(_cleaned, 30) / _median, 2),
    'medium': round(np.percentile(_cleaned, 50) / _median, 2),
    'complex': round(np.percentile(_cleaned, 75) / _median, 2),
}

#Run Experiment 2 with following input:
result_2 = simulate_parallel_integrations(
    historical_data = raw_jira_data,
    integration_complexities = ['simple', 'medium', 'medium'],
    complexity_multipliers = complexity_multipliers, #Could be manually passed as other constants as a dict {'name': value}
    min_days = 4,
    max_days = 90,
    n_simulations = 10_000,
    percentiles = [50, 75, 85, 95],
    random_seed = 42,
)

review_experiment(result_2)





def simulate_with_parameters(
    historical_data: list,
    complexity_distribution: dict,
    complexity_multipliers: dict,
    capacity_distribution: dict,
    capacity_multipliers: dict,
    experience_distribution: dict,
    experience_multipliers: dict,
    provider_distribution: dict,
    provider_delay_days: dict,
    min_days: int = 4,
    max_days: int = 90,
    n_simulations: int = 10_000,
    percentiles: list = [50, 75, 85, 95],
    random_seed: int = 42,
) -> SimulationResult:

    # Validation that all distribution probabilities sum to 1.0
    for name, dist in [
        ('complexity_distribution', complexity_distribution),
        ('capacity_distribution', capacity_distribution),
        ('experience_distribution', experience_distribution),
        ('provider_distribution', provider_distribution),
    ]:
        total = sum(dist.values())
        if not abs(total - 1.0) < 1e-6:
            raise ValueError(
                f"{name} probabilities must sum to 1.0, current sum is {total:.1f}."
            )

    # Validate multiplier keys match distribution keys
    for dist, lookup, dist_name, lookup_name in [
        (complexity_distribution, complexity_multipliers,
         'complexity_distribution', 'complexity_multipliers'),
        (capacity_distribution, capacity_multipliers,
         'capacity_distribution', 'capacity_multipliers'),
        (experience_distribution, experience_multipliers,
         'experience_distribution','experience_multipliers'),
        (provider_distribution, provider_delay_days,
         'provider_distribution', 'provider_delay_days'),
    ]:
        for label in dist:
            if label not in lookup:
                raise ValueError(
                    f"Label '{label}' found in {dist_name} "
                    f"but not in {lookup_name}."
                )

    # Clean the data
    cleaned = clean_data(historical_data, min_days, max_days)
    removed = sorted([x for x in historical_data if x <= min_days or x > max_days])

    print(f"Raw observations: {len(historical_data)}")
    print(f"After cleaning: {len(cleaned)}")
    print(f"Removed: {len(removed)} values ")
    print(f"Removed values: {removed}")

    # Building the PyMC model

    with pm.Model() as model:

        # Base cycle time = empirical distribution via numpy resampling applied as a DiscreteUniform index into the cleaned dataset
        base_idx = pm.DiscreteUniform(
            'base_idx', lower=0, upper=len(cleaned) - 1
        )

        # Complexity
        complexity_labels = list(complexity_distribution.keys())
        complexity_probs  = list(complexity_distribution.values())
        complexity_idx    = pm.Categorical(
            'complexity_idx', p=complexity_probs
        )

        # Capacity
        capacity_labels = list(capacity_distribution.keys())
        capacity_probs  = list(capacity_distribution.values())
        capacity_idx    = pm.Categorical(
            'capacity_idx', p=capacity_probs
        )

        # Experience
        experience_labels = list(experience_distribution.keys())
        experience_probs  = list(experience_distribution.values())
        experience_idx    = pm.Categorical(
            'experience_idx', p=experience_probs
        )

        # Provider delay
        provider_labels = list(provider_distribution.keys())
        provider_probs  = list(provider_distribution.values())
        provider_idx    = pm.Categorical(
            'provider_idx', p=provider_probs
        )

        # Sample from the model
        with model:
            trace = pm.sample_prior_predictive(
                samples = n_simulations,
                random_seed=random_seed,
                return_inferencedata=True,
            )

    # Extracting samples and computing durations
    prior = trace.prior

    base_indices = prior['base_idx'].values.flatten()
    complexity_draws = prior['complexity_idx'].values.flatten()
    capacity_draws = prior['capacity_idx'].values.flatten()
    experience_draws = prior['experience_idx'].values.flatten()
    provider_draws = prior['provider_idx'].values.flatten()

    cleaned_arr = np.array(cleaned)

    # Map indices back to values
    base_times = cleaned_arr[base_indices]
    c_multipliers = np.array([complexity_multipliers[complexity_labels[i]]
                                 for i in complexity_draws])
    cap_multipliers = np.array([capacity_multipliers[capacity_labels[i]]
                                 for i in capacity_draws])
    exp_multipliers = np.array([experience_multipliers[experience_labels[i]]
                                 for i in experience_draws])
    prov_delays = np.array([provider_delay_days[provider_labels[i]]
                                 for i in provider_draws])

    # Compiling the C = base x complexity x capacity x experience + provider_delay; No upper cap applied
    all_durations = (
        base_times
        * c_multipliers
        * cap_multipliers
        * exp_multipliers
        + prov_delays
    ).astype(float)

    # Store results in dataclass 
    percentile_forecasts = compute_percentiles(all_durations, percentiles)

    result = SimulationResult(
        experiment_label='Experiment 3: Multi Parameter Simulation',
        cleaned_data=cleaned,
        all_durations=all_durations,
        percentile_forecasts=percentile_forecasts,
        mean=float(np.mean(all_durations)),
        median=float(np.median(all_durations)),
        std=float(np.std(all_durations)),
        parameters_used={
            'complexity_distribution': complexity_distribution,
            'complexity_multipliers': complexity_multipliers,
            'capacity_distribution': capacity_distribution,
            'capacity_multipliers': capacity_multipliers,
            'experience_distribution': experience_distribution,
            'experience_multipliers': experience_multipliers,
            'provider_distribution': provider_distribution,
            'provider_delay_days': provider_delay_days,
            'min_days': min_days,
            'max_days': max_days,
            'n_simulations': n_simulations,
            'percentiles': percentiles,
            'random_seed': random_seed,
        }
    )
    return result


